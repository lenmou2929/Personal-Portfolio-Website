		<!-- S7 精选（v4）：深色底随场升起至满屏→pin 冻结，底块+卡片在固定层内滑入 -->
		<section class="scene scene-dark" id="scene-rail">
			<div class="scene-dark-bg"></div>
			<div class="scene-inner">
				<div class="sec-head"><h2>Selected Works</h2><span class="idx">03 — Selected</span></div>
				<div class="rail-wrap">
