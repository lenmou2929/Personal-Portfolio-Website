---
import BaseLayout from '../layouts/BaseLayout.astro';

const contacts = [
	{ label: '邮箱', value: 'chenjizulenning@163.com', href: 'mailto:chenjizulenning@163.com' },
	{ label: '电话', value: '187 7262 5248', href: 'tel:18772625248' },
	{ label: 'GitHub', value: 'lenmou2929', href: 'https://github.com/lenmou2929', ext: true },
	{ label: '公益站', value: 'bitsugar.top', href: 'https://bitsugar.top', ext: true },
	{ label: 'Bilibili', value: '冷某不太冷 · 个人空间', href: 'https://b23.tv/BNE4IKm', ext: true },
	{ label: '小红书', value: '个人主页 · 获赞藏 1000+', href: 'https://xhslink.cn/m/A7J14qagF7t', ext: true },
];
---

<BaseLayout fixedTheme="light" title="联系 | 陈继祖作品集" description="联系陈继祖：邮箱、电话、GitHub、社交媒体与简历下载。">
	<main class="wrapper stack gap-10 page">
		<header class="stack gap-3">
			<p class="kicker">05 — CONTACT</p>
			<h1>联系我</h1>
		</header>

		<ul class="facts">
			{
				contacts.map((c) => (
					<li>
						<span>{c.label}</span>
						{c.href ? (
							<a href={c.href} target={c.ext ? '_blank' : undefined} rel={c.ext ? 'noopener' : undefined}>
								{c.value}
							</a>
						) : (
							<b>{c.value}</b>
						)}
					</li>
				))
			}
			<li>
				<span>简历 PDF</span>
				<a href="/resume/resume-chenjizu-3d.pdf" download>3D / 地编方向 ↓</a>
			</li>
			<li>
				<span>简历 PDF</span>
				<a href="/resume/resume-chenjizu-aigc.pdf" download>AIGC 方向 ↓</a>
			</li>
		</ul>
	</main>
</BaseLayout>

<style>
	.page {
		padding-block: 3rem 5rem;
	}

	.kicker {
		font-family: var(--mono);
		font-size: 12px;
		letter-spacing: 0.2em;
		color: var(--ink-2);
	}

	h1 {
		color: var(--ink);
		font-size: clamp(28px, 3.6vw, 44px);
		letter-spacing: 0.03em;
	}

	/* 线性 UI：虚线分隔行（同示意稿 fact 条） */
	.facts {
		list-style: none;
		margin: 0;
		padding: 0;
		max-width: 560px;
	}

	.facts li {
		display: flex;
		justify-content: space-between;
		gap: 20px;
		padding: 14px 0;
		border-bottom: 1px dashed var(--line);
		font-size: 14.5px;
	}

	.facts span {
		color: var(--ink-2);
	}

	.facts a,
	.facts b {
		color: var(--ink);
		font-weight: 600;
		text-align: right;
		text-decoration: none;
	}

	.facts a:hover {
		color: var(--accent);
	}
</style>
