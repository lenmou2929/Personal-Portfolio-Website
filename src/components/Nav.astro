---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
	/** 固定主题页（差异化深色分类页）隐藏明暗切换器 */
	hideThemeToggle?: boolean;
}

const { hideThemeToggle = false } = Astro.props;

/** 顶栏导航（内页）：路由版；首页顶栏为锚点版（index.astro 内联，样式同源） */
const links: { label: string; href: string }[] = [
	{ label: '作品', href: '/works/' },
	{ label: '关于', href: '/about/' },
	{ label: '联系', href: '/contact/' },
];

const isCurrentPage = (href: string) => {
	let pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
	if (pathname.at(0) !== '/') pathname = '/' + pathname;
	if (pathname.at(-1) !== '/') pathname += '/';
	return pathname === href || (href !== '/' && pathname.startsWith(href));
};
---

<header class="topbar">
	<div class="brand">
		<a href="/"><b>陈继祖</b><span>CHEN JIZU — 3D / WEB</span></a>
	</div>
	<nav class="nav-center" aria-label="主导航">
		{
			links.map(({ label, href }) => (
				<a href={href} aria-current={isCurrentPage(href) ? 'page' : null}>
					{label}
				</a>
			))
		}
	</nav>
	<div class="nav-right">
		{!hideThemeToggle && <ThemeToggle />}
		<span class="lang">中 / EN</span>
		<a class="resume" href="/contact/">简历下载</a>
	</div>
</header>

<style>
	/* 顶栏（2026-09-06 用户拍板：内页与首页同款——纯文字无边框，样式与
	   index.astro .topbar 同源同值；当前页用强调色标记 */
	.topbar {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 50;
		display: flex;
		align-items: center;
		padding: 20px 40px;
		background: var(--bg);
	}
	.brand {
		display: flex;
		align-items: baseline;
		gap: 12px;
	}
	.brand a {
		display: flex;
		align-items: baseline;
		gap: 12px;
		text-decoration: none;
	}
	.brand b {
		font-size: 17px;
		letter-spacing: 0.06em;
		font-weight: 700;
		color: var(--ink);
	}
	.brand span {
		font-family: var(--mono);
		font-size: 11px;
		color: var(--ink-2);
		letter-spacing: 0.08em;
	}
	.nav-center {
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		gap: 44px;
	}
	.nav-center a {
		font-size: 14px;
		letter-spacing: 0.04em;
		color: var(--ink);
		text-decoration: none;
		transition: color 0.2s;
	}
	.nav-center a:hover {
		color: var(--accent);
	}
	.nav-center a[aria-current='page'] {
		color: var(--accent);
	}
	.nav-right {
		margin-left: auto;
		display: flex;
		align-items: center;
		gap: 16px;
	}
	.nav-right :global(button) {
		cursor: pointer;
	}
	.nav-right .lang {
		font-family: var(--mono);
		font-size: 12px;
		color: var(--ink-2);
	}
	.nav-right .resume {
		font-size: 17px;
		font-weight: 700;
		letter-spacing: 0.06em;
		color: var(--ink);
		text-decoration: none;
		transition: color 0.2s;
	}
	.nav-right .resume:hover {
		color: var(--accent);
	}

	/* 移动端：首页隐藏中导航（单页锚点），内页保留链接改为同行紧凑排布 */
	@media (max-width: 900px) {
		.topbar {
			padding: 14px 20px;
		}
		.brand span {
			display: none;
		}
		.nav-center {
			position: static;
			transform: none;
			margin-left: auto;
			gap: 18px;
		}
		.nav-right {
			gap: 12px;
			margin-left: 14px;
		}
		.nav-right .lang {
			display: none;
		}
		.nav-right .resume {
			font-size: 15px;
		}
	}
</style>
