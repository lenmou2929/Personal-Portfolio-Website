---
// Learn about using Astro layouts:
// https://docs.astro.build/en/basics/layouts/

import Footer from '../components/Footer.astro';
// Component Imports
import MainHead from '../components/MainHead.astro';
import Nav from '../components/Nav.astro';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
	/** 固定主题（分类页差异化固定深色）：传 'dark' 后页面钉死深色且隐藏主题切换器 */
	fixedTheme?: 'dark' | 'light' | undefined;
}

const { title, description, fixedTheme } = Astro.props;
---

<html lang="zh-CN">
	<head>
		<MainHead title={title} description={description} fixedTheme={fixedTheme} />
	</head>
	<body>
		<!-- 无障碍：skip-to-content（impeccable 遗留项，2026-09-06 补）——Tab 首焦直达正文 -->
		<a class="skip-link" href="#main">跳到主要内容</a>
		<div class="stack backgrounds">
			<Nav hideThemeToggle={!!fixedTheme} />
			<div class="under-topbar" id="main">
				<slot />
			</div>
			<Footer />
		</div>

		<script>
			// Add “loaded” class once the document has completely loaded.
			addEventListener('load', () => document.documentElement.classList.add('loaded'));
		</script>

		<style>
			/* 无障碍跳转链接：平时隐藏，键盘 Tab 聚焦时出现在左上角 */
			.skip-link {
				position: fixed;
				top: -52px;
				left: 16px;
				z-index: 100;
				padding: 9px 16px;
				background: var(--accent);
				color: #fff;
				border-radius: 999px;
				font-size: 13px;
				text-decoration: none;
				transition: top 0.2s;
			}

			.skip-link:focus {
				top: 12px;
			}

			/* 模板星云背景图系统已剥离（2026-09-04），2026-09-06 清掉残留的死变量——
			   纯色底由项目 tokens（--gray-999 主题感知）控制 */
			.backgrounds {
				min-height: 100%;
				isolation: isolate;
				background: var(--gray-999);
			}
			@media (forced-colors: active) {
				.backgrounds {
					background: none;
				}
			}
			/* 内页顶栏改首页同款 fixed 定位：用自己的包裹层让出顶栏高度
			   （首页不经 BaseLayout，不受影响） */
			.under-topbar {
				padding-top: 88px;
			}
			@media (max-width: 900px) {
				.under-topbar {
					/* 移动端顶栏两行（品牌行 + 五项链接行） */
					padding-top: 96px;
				}
			}
		</style>
	</body>
</html>
