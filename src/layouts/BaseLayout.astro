---
// Learn about using Astro layouts:
// https://docs.astro.build/en/basics/layouts/

import Footer from '../components/Footer.astro';
// Component Imports
import MainHead from '../components/MainHead.astro';
import Nav from '../components/Nav.astro';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
	/** 固定主题（分类页差异化固定深色）：传 'dark' 后页面钉死深色且隐藏主题切换器 */
	fixedTheme?: 'dark' | 'light' | undefined;
}

const { title, description, fixedTheme } = Astro.props;
---

<html lang="zh-CN">
	<head>
		<MainHead title={title} description={description} fixedTheme={fixedTheme} />
	</head>
	<body>
		<div class="stack backgrounds">
			<Nav hideThemeToggle={!!fixedTheme} />
			<slot />
			<Footer />
		</div>

		<script>
			// Add “loaded” class once the document has completely loaded.
			addEventListener('load', () => document.documentElement.classList.add('loaded'));
		</script>

		<style>
			/* 模板星云背景图系统已剥离（2026-09-04），2026-09-06 清掉残留的死变量——
			   纯色底由项目 tokens（--gray-999 主题感知）控制 */
			.backgrounds {
				min-height: 100%;
				isolation: isolate;
				background: var(--gray-999);
			}
			@media (forced-colors: active) {
				.backgrounds {
					background: none;
				}
			}
		</style>
	</body>
</html>
