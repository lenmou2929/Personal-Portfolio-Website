---
/**
 * EN 首页（2026-09-06 第 20 次会话）：index.astro v4.2 的翻译副本——动效/样式原样保留，
 * 文案英译；中文首页改数值后需手动同步本文件（含 SCENE_PIN_VH 等常量）。
 * 首页 —— 自定稿示意稿 mockups/方案A-v3-衬线编辑风.html 逐屏迁移（2026-09-04 第 17 次会话）。
 * 与示意稿的差异（定稿约定）：
 * 1. 动效为 scroll 事件驱动（示意稿的 setInterval 兜底轮询是测试环境专用，正式站禁用）
 * 2. 精选卡片来自作品 collection（level: S），诚实标注角标取自 frontmatter
 * 3. 首页固定浅色暖纸底（独立 head，无主题脚本；2026-09-04 用户拍板）
 * 4. 进场机制 v2（2026-09-04 用户提案）：三场景入场从 pin 内前移至「进场窗口」——
 *    内容锁定最终屏幕高度（y:-100vh→0）+ 左右滑入，页面到位 = 入场完成，
 *    消除进场途中隐形盒子+隐藏内容造成的空白页与冻住感；pin 只负责停留（+=35%）。
 *    stage1 与页尾不变。详见 README 决策表与日志 17
 * 5. 进场机制 v4（2026-09-04 用户拍板）：每场一个 135vh 的 GSAP pin——内容层被原生
 *    fixed 锁在屏幕上，新内容在固定层内左右滑入（出现即在固定高度，零补偿竞态）；
 *    pin 前半旧内容以原生滚动从其后方退场。margin-top:-100vh 使每场对齐上一场
 *    pin 结束点，场间在 pin 边界无缝交接。v2/v2.1（补偿锁）与 v3（sticky 随行）
 *    的完整历程见 README 决策表与日志 17
 * 动效定稿数值以 mockups/手动调整手册.md 为索引（pin 170% / 视差 8/16/16/13vh / rail 1s·0.25 / 页尾 y:150 等）。
 */
import { getCollection } from 'astro:content';
import { WORK_CATEGORIES } from '../../lib/categories';
import { CATEGORY_IMAGES } from '../../lib/category-images';
import { ATTR_EN, CAT_EN, WORK_EN } from '../../lib/i18n-en';
import '../../styles/global.css';

/* 精选 = level S；排序与分类页同规则：order 置顶（小者在前）→ 日期新→旧 → id
   （order 在条目 frontmatter，用户可直接改 md 调精选顺序） */
const featured = (await getCollection('work', ({ data }) => !data.draft && data.level === 'S')).sort(
	(a, b) => {
		const oa = a.data.order ?? null;
		const ob = b.data.order ?? null;
		if (oa !== null && ob !== null) return oa - ob;
		if (oa !== null) return -1;
		if (ob !== null) return 1;
		if (a.data.date.valueOf() !== b.data.date.valueOf())
			return b.data.date.valueOf() - a.data.date.valueOf();
		return a.id < b.id ? -1 : 1;
	},
);

const ATTR_EN = { 原创: 'ORIGINAL', 参考还原: 'REFERENCE', 教程跟做: 'TUTORIAL' } as const;


/* 分类卡 = WORK_CATEGORIES 单一来源（label/顺序），配图单一来源 category-images */
const cats = WORK_CATEGORIES.map((c) => ({ ...c, img: CATEGORY_IMAGES[c.key] }));

const blocks = [
	{
		side: 'col-l',
		no: 'no.01',
		title: 'UE5 Environment Art / 3D',
		lines: 'Film & Product<br>Blender · UE5 Pipeline',
	},
	{
		side: 'col-l',
		no: 'no.02',
		title: 'AI-Assisted Developer',
		lines: '2 Live Web Products<br>Vibecoding Workflow',
	},
	{
		side: 'col-r',
		no: 'no.03',
		title: 'Shenzhen · Available Now',
		lines: 'Class of 2026<br>Alternate 6-day weeks OK',
	},
	{
		side: 'col-r',
		no: 'no.04',
		title: 'Toolbox',
		lines: 'UE5 · Blender · MD · SP<br>PS · AI · PR · AE · AU · RESOLVE · ZB',
	},
];
---

