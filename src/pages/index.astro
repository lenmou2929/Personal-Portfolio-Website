---
/**
 * 首页 —— 自定稿示意稿 mockups/方案A-v3-衬线编辑风.html 逐屏迁移（2026-09-04 第 17 次会话）。
 * 与示意稿的差异（定稿约定）：
 * 1. 动效为 scroll 事件驱动（示意稿的 setInterval 兜底轮询是测试环境专用，正式站禁用）
 * 2. 精选卡片来自作品 collection（level: S），诚实标注角标取自 frontmatter
 * 3. 首页固定浅色暖纸底（独立 head，无主题脚本；2026-09-04 用户拍板）
 * 4. 进场机制 v2（2026-09-04 用户提案）：三场景入场从 pin 内前移至「进场窗口」——
 *    内容锁定最终屏幕高度（y:-100vh→0）+ 左右滑入，页面到位 = 入场完成，
 *    消除进场途中隐形盒子+隐藏内容造成的空白页与冻住感；pin 只负责停留（+=35%）。
 *    stage1 与页尾不变。详见 README 决策表与日志 17
 * 动效定稿数值以 mockups/手动调整手册.md 为索引（pin 170% / 视差 8/16/16/13vh / rail 1s·0.25 / 页尾 y:150 等）。
 */
import { getCollection } from 'astro:content';
import '../styles/global.css';

const featured = (await getCollection('work', ({ data }) => !data.draft && data.level === 'S')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const ATTR_EN = { 原创: 'ORIGINAL', 参考还原: 'REFERENCE', 教程跟做: 'TUTORIAL' } as const;

const cats = [
	{ key: '3d', label: '3D 美术', en: '3D / LOOKDEV', img: '/works/phone-front.jpg' },
	{ key: 'graphic', label: '平面设计', en: 'GRAPHIC', img: '/works/galaxy-poster.jpg' },
	{ key: 'vibecoding', label: 'Vibecoding', en: 'WEB APP', img: '/works/scarab-sphere.jpg' },
	{ key: 'planning', label: '项目策划', en: 'PLANNING', img: '/works/logo-grid.jpg' },
];

const blocks = [
	{
		side: 'col-l',
		no: 'no.01',
		title: '3D 场景美术 / 地编',
		lines: '影视向 · 产品向<br>Blender · UE5 全流程',
	},
	{
		side: 'col-l',
		no: 'no.02',
		title: 'AI 辅助开发者',
		lines: '2 个上线 Web 产品<br>Vibecoding 工作流',
	},
	{
		side: 'col-r',
		no: 'no.03',
		title: '深圳 · 随时到岗',
		lines: '2026 届应届<br>接受大小周',
	},
	{
		side: 'col-r',
		no: 'no.04',
		title: '工具箱',
		lines: 'PS · AI · PR · AE · AU · RESOLVE · XMIND<br>BLENDER · UE5 · MD · SP',
	},
];
---

