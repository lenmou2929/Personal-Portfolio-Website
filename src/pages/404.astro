---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在 | 陈继祖作品集" description="404——页面不存在或已被移动。">
	<main class="wrapper notfound">
		<p class="kicker">404 — NOT FOUND</p>
		<h1>页面走丢了</h1>
		<p class="sub">这个地址不存在或已被移动——作品和联系方式都在下面。<br />This page does not exist or has been moved — works and contact info are linked below.</p>
		<div class="cta-row">
			<a href="/">返回首页</a>
			<a href="/works/3d/">查看作品</a>
			<a class="ghost" href="/contact/">联系方式 →</a>
		</div>
	</main>
</BaseLayout>

<style>
	.notfound {
		padding-block: 6rem 8rem;
	}

	.kicker {
		font-family: var(--mono);
		font-size: 12px;
		letter-spacing: 0.2em;
		color: var(--ink-2);
	}

	h1 {
		color: var(--ink);
		font-size: clamp(30px, 4vw, 52px);
		letter-spacing: 0.03em;
		margin-top: 14px;
	}

	.sub {
		max-width: 560px;
		margin-top: 14px;
		font-size: 15px;
		line-height: 1.9;
		color: var(--ink-2);
	}

	.cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 30px;
	}

	.cta-row a {
		font-size: 14px;
		color: var(--ink);
		text-decoration: none;
		border: 1px solid var(--line);
		border-radius: 999px;
		padding: 10px 20px;
		transition:
			color 0.2s,
			border-color 0.2s;
	}

	.cta-row a:hover {
		color: var(--accent);
		border-color: var(--accent);
	}

	.cta-row a.ghost {
		border-style: dashed;
	}
</style>
