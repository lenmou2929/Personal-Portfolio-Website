</html>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	/* 不设 html{scroll-behavior:smooth}——与 ScrollTrigger pin 冲突（官方已知问题）。
	   正式站动效为 scroll 事件驱动：ScrollTrigger 原生监听 scroll 事件，无兜底轮询。 */
	if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		gsap.registerPlugin(ScrollTrigger);

		/* S1–S3 首屏：四块滑入 + 大字让位 + 停留；pin 结束后整页随自然滚动划走（不做内部 transform 出画） */
		const tl = gsap.timeline({
			scrollTrigger: { trigger: '#stage1', start: 'top top', end: '+=170%', pin: true, scrub: 0.5 },
		});
		tl.to('.scroll-hint', { opacity: 0, duration: 0.5 }, 0)
			.from('.blk.col-l', { x: -70, opacity: 0, duration: 0.42, stagger: 0.07, ease: 'power2.out' }, 0.02)
			.from('.blk.col-r', { x: 70, opacity: 0, duration: 0.42, stagger: 0.07, ease: 'power2.out' }, 0.1)
			.to('.hero-cluster', { y: '-20vh', duration: 0.5, ease: 'none' }, 0)
			.to({}, { duration: 0.12 });

		/* 首屏划走期间：四块相对首屏下滑 8vh（滞后出画，画面持续有内容）。
		   v4 窗口 = about 层钉住后的第一屏（= 首屏在其后方 1:1 退场的行程）。
		   ⚠️ 不能用 'top bottom'——负 margin 使 about 提前 100vh，会让四块在首屏
		   pin 内（页面还没开始滑）就提前下移 */
		gsap.to('.blocks', {
			y: '2vh',
			ease: 'none',
			scrollTrigger: {
				trigger: '#scene-about',
				start: 'top top',
				end: () => '+=' + window.innerHeight,
				scrub: 0.5,
			},
		});

		/* ============ 三场景（v4 固定层架构，README 决策表 2026-09-04） ============
		   每场被 GSAP pin 钉住 140vh（SCENE_PIN_VH，进场一屏 + 停留 0.4 屏）：内容层
		   position:fixed 原生锁在屏幕——新内容出现即在固定高度、左右滑入，零补偿竞态
		   （v2 的病根不存在）。pin 前半旧内容以原生滚动从其后方退场（透明层透出；时序上
		   旧内容退出 ~60% 后新内容才出现，避免叠字）。margin-top:-100vh（见 CSS）使每场
		   自然顶 = 上一场 pin 结束点，场间在 pin 边界无缝交接。子元素补间 scrub 0.5
		   （纯外观平滑，位置锁由 pin 承担，与 v2 的补偿锁有本质区别） */
		/* 场长唯一入口：pin 三处与导航落点共用——调这里即可，勿单改一处 */
		const SCENE_PIN_VH = 1.4;
		gsap
			.timeline({
				scrollTrigger: {
					trigger: '#scene-about',
					start: 'top top',
					end: () => '+=' + Math.round(window.innerHeight * SCENE_PIN_VH),
					pin: true,
					scrub: 0.5,
					toggleClass: 'is-pinned',
				},
			})
			.from('#scene-about .sec-head', { autoAlpha: 0, duration: 0.22 }, 0.4)
			.from(
				'#scene-about .sec-head h2, #scene-about .sec-head .idx',
				{ x: -90, duration: 0.28, stagger: 0.05, ease: 'power2.out' },
				0.4,
			)
			.from('#scene-about .lead', { x: -80, autoAlpha: 0, duration: 0.3, ease: 'power2.out' }, 0.46)
			.from(
				'#scene-about .fact',
				{ x: 90, autoAlpha: 0, duration: 0.18, stagger: 0.05, ease: 'power2.out' },
				0.5,
			)
			.from('#scene-about .award-line', { y: 70, autoAlpha: 0, duration: 0.24, ease: 'power2.out' }, 0.6);

		gsap
			.timeline({
				scrollTrigger: {
					trigger: '#scene-cats',
					start: 'top top',
					end: () => '+=' + Math.round(window.innerHeight * SCENE_PIN_VH),
					pin: true,
					scrub: 0.5,
					toggleClass: 'is-pinned',
				},
			})
			.from('#scene-cats .sec-head', { autoAlpha: 0, duration: 0.22 }, 0.4)
			.from(
				'#scene-cats .sec-head h2, #scene-cats .sec-head .idx',
				{ x: -90, duration: 0.28, stagger: 0.05, ease: 'power2.out' },
				0.4,
			)
			.from(
				'#scene-cats .cats',
				{
					x: () => {
						const r = document.querySelector('#scene-cats .cats')!.getBoundingClientRect();
						return -(r.left + r.width + 80);
					},
					duration: 0.42,
					ease: 'power2.out',
				},
				0.45,
			);

		gsap
			.timeline({
				scrollTrigger: {
					trigger: '#scene-rail',
					start: 'top top',
					end: () => '+=' + Math.round(window.innerHeight * SCENE_PIN_VH),
					pin: true,
					scrub: 0.5,
					toggleClass: 'is-pinned',
				},
			})
			/* 深色底在固定层内部升起（0→0.3 升满）——分类场随行阶段保持全透明不被入侵 */
			.from('#scene-rail .scene-dark-bg', { y: '100vh', duration: 0.3, ease: 'none' }, 0)
			.from('#scene-rail .sec-head', { autoAlpha: 0, duration: 0.22 }, 0.28)
			.from(
				'#scene-rail .sec-head h2, #scene-rail .sec-head .idx',
				{ x: -90, duration: 0.28, stagger: 0.05, ease: 'power2.out' },
				0.28,
			)
			.from('#scene-rail .rail-bg', { x: '100vw', duration: 0.38, ease: 'power1.out' }, 0.32)
			.from(
				'#scene-rail .rail',
				{
					x: () => {
						const r = document.querySelector('#scene-rail .rail')!.getBoundingClientRect();
						return window.innerWidth - r.left + 80;
					},
					duration: 0.42,
					ease: 'power3.out',
				},
				0.42,
			);

		/* S8 页尾：从下渐显进场 */
		gsap.from('.foot-inner', {
			y: 150,
			autoAlpha: 0,
			duration: 0.55,
			ease: 'power2.out',
			scrollTrigger: { trigger: 'footer', start: 'top 65%', end: 'top 20%', scrub: 0.5 },
		});

		/* 导航点击：落到场景 pin 的停留段（pin 起点 + 场长×0.9，入场已完成、内容完整固定）。
		   注意必须从 ScrollTrigger 实例取 start——pin 包装后 offsetTop/rect 都是相对 spacer 的，不可靠 */
		document.querySelectorAll<HTMLAnchorElement>('.nav-center a').forEach((a) => {
			a.addEventListener('click', (e) => {
				e.preventDefault();
				const sel = a.getAttribute('href')!;
				const t = ScrollTrigger.getAll().find(
					(t) => t.trigger && t.trigger.id === sel.slice(1) && t.pin,
				);
				if (t) {
					window.scrollTo(0, t.start + Math.round(window.innerHeight * SCENE_PIN_VH * 0.9));
				} else {
					window.scrollTo(0, document.documentElement.scrollHeight);
				}
			});
		});
	}
</script>

<style>
	/* ============ 首页样式：示意稿定稿数值原样迁移（变量走项目 tokens） ============ */

	/* ---------- 顶栏 ---------- */
	.topbar {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 50;
		display: flex;
		align-items: center;
		padding: 20px 40px;
		background: var(--bg);
	}
	.brand {
		display: flex;
		align-items: baseline;
