					))
				}
			</div>
			<div class="scroll-hint"><span>SCROLL</span><div class="cap"><i></i></div></div>
		</section>

		<!-- S4 关于我（v4）：整场被 pin 钉住 135vh——内容层原生 fixed 锁在屏幕上，
		     新内容于固定高度从左右滑入；pin 前半旧内容（首屏）以原生滚动从其后方退场 -->
		<section class="scene" id="scene-about">
			<div class="scene-inner">
