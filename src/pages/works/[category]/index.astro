---
import { getCollection } from 'astro:content';
import ModelStage from '../../../components/ModelStage.astro';
import PageHead from '../../../components/PageHead.astro';
import WorkCard from '../../../components/WorkCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { WORK_CATEGORIES } from '../../../lib/categories';
import { CATEGORY_IMAGES } from '../../../lib/category-images';

export async function getStaticPaths() {
	return WORK_CATEGORIES.map((cat) => ({ params: { category: cat.key }, props: { cat } }));
}

type Props = { cat: (typeof WORK_CATEGORIES)[number] };
const { cat } = Astro.props;
/* 排序：日期新→旧，同日期按分级 S→A→B（S 主推在前、B 跟练类沉底，03-作品集规划），
   同级内按 order（策展序，缺省排后），最后按 id 保证稳定 */
const LEVEL_RANK: Record<string, number> = { S: 0, A: 1, B: 2 };
const sorted = (
	await getCollection('work', ({ data }) => !data.draft && data.category === cat.key)
).sort((a, b) => {
	if (a.data.date.valueOf() !== b.data.date.valueOf())
		return b.data.date.valueOf() - a.data.date.valueOf();
	const ra = LEVEL_RANK[a.data.level] ?? 1;
	const rb = LEVEL_RANK[b.data.level] ?? 1;
	if (ra !== rb) return ra - rb;
	const oa = a.data.order ?? Number.MAX_SAFE_INTEGER;
	const ob = b.data.order ?? Number.MAX_SAFE_INTEGER;
	if (oa !== ob) return oa - ob;
	return a.id < b.id ? -1 : 1;
});
const entries = [
	...sorted.filter((e) => !e.data.title.startsWith('占位')),
	...sorted.filter((e) => e.data.title.startsWith('占位')),
];
/* 底部互推：另外两个分类（2026-09-06 IA 重构——索引页退役后跨类动线落在这里） */
const others = WORK_CATEGORIES.filter((c) => c.key !== cat.key);

const LEADS: Record<string, string> = {
	'3d': 'UE5 地编与 Blender 全流程——场景搭建、材质 lookdev、灯光渲染出图，影视向与产品向并行。',
	vibecoding: 'AI 辅助开发的上线 Web 产品——需求、开发、部署独立完成，能点开的 Demo 就是作品本身。',
	graphic: '平面科班底子——品牌、包装、海报与线下物料，一切版式功底的地基。',
};
---

<BaseLayout title={`${cat.label} | 陈继祖作品集`} description={`陈继祖作品集 · ${cat.label}分类作品`} fixedTheme="dark">
	<main class="wrapper page">
	{
			cat.key === '3d' ? (
				/* 3D 页：fixed 渲染层铺满视口 = 页首（标题/导语随内容上移，模型与渲染框不动） */
				<ModelStage
					src="/models/telephone-2k.glb"
					poster="/works/phone-front.jpg"
					no={cat.no}
					en={cat.en}
					title={cat.label}
					lead={LEADS[cat.key]}
				/>
			) : (
				<PageHead no={cat.no} en={cat.en} title={cat.label} lead={LEADS[cat.key]} />
			)
		}

		<!-- 内容层：3D 页带分界底色（覆盖 fixed 渲染层的滚动分界）；其它分类页透明（无渲染层） -->
		<div class:list={['page-body', { cover: cat.key === '3d' }]}>
			{
				cat.key === 'vibecoding' && (
					<section class="showcase">
						<div class="live-frame">
							<div class="chrome">
								<span class="dots" aria-hidden="true"><i /><i /><i /></span>
								<span class="url">bitsugar.top</span>
								<a class="open" href="https://bitsugar.top" target="_blank" rel="noopener">
									新窗口打开 ↗
								</a>
							</div>
							<div class="frame-box">
								<iframe
									src="https://bitsugar.top"
									loading="lazy"
									title="BitSugar 拼豆图纸站（在线实时嵌入）"
								/>
								<button class="activate" type="button">
									<span class="activate-pill">点击互动实机</span>
								</button>
								<p class="load-fail" hidden>
									嵌入加载失败——<a
										href="https://bitsugar.top"
										target="_blank"
										rel="noopener">bitsugar.top ↗</a
									>
								</p>
							</div>
						</div>
						<aside class="side">
							<div class="status-card">
								<p class="status"><span class="pulse" />LIVE — 已上线</p>
								<p class="desc">域名、DNS、部署、站长平台提交全流程独立完成，GitHub 开源。</p>
								<div class="links">
									<a href="https://bitsugar.top" target="_blank" rel="noopener">bitsugar.top ↗</a>
									<a
										href="https://github.com/lenmou2929/BitSugar"
										target="_blank"
										rel="noopener">GitHub ↗</a
									>
								</div>
							</div>
							<div class="status-card muted">
								<p class="status"><span class="pulse dev" />DEV — 开发中</p>
								<p class="desc">
									3D 模型预览器（雪板专用）——部署后以同款方式嵌入本页，演示录屏备制中。
								</p>
							</div>
						</aside>
					</section>
				)
			}

			{
				cat.key === 'graphic' && (
					<section class="graph-hero">
						<span class="ghost" aria-hidden="true">Graphic</span>
					</section>
				)
			}

			<section class="works">
				<h2>
					本类作品
					<span class="count">{String(entries.length).padStart(2, '0')}</span>
				</h2>
				{
					entries.length === 0 ? (
						<p class="empty">本分类作品整理中——素材核对完成后逐件上架。</p>
					) : (
						<ul class:list={['cards', { single: entries.length === 1 }]}>
							{entries.map((w, i) => <WorkCard entry={w} index={i} />)}
						</ul>
					)
				}
			</section>

			{
				others.length > 0 && (
					<section class="more-cats">
						<h2>
							继续看<span class="count-alt">其它两类作品</span>
						</h2>
						<div class="more-grid">
							{others.map((c) => (
								<a class="more-card" href={`/works/${c.key}/`} aria-label={`进入「${c.label}」分类`}>
									<div class="catbox">
										<img src={CATEGORY_IMAGES[c.key]} alt={`${c.label}分类封面`} loading="lazy" />
										<div class="veil" />
										<span class="no">{c.no}</span>
										<div class="label">
											<b>{c.label}</b>
											<span>{c.en}</span>
										</div>
									</div>
								</a>
							))}
						</div>
					</section>
				)
			}
		</div>
	</main>

	<!-- 作品条：点击卡片自下滑出（2026-09-06 IA 重构——详情页退役，?w=id 深链直达） -->
	<div class="sheet-layer" id="work-sheet">
		<div class="sheet-backdrop" data-sheet-close />
		<div class="sheet" role="dialog" aria-modal="true" aria-label={`${cat.label}作品预览`}>
			<button class="sheet-close" type="button" data-sheet-close aria-label="关闭作品预览">
				✕
			</button>
			<div class="sheet-body">
				{
					entries.map((w, i) => (
						<article class="work-panel" data-panel={w.id} hidden>
							<div class="wp-head">
								<span class="wp-no">no.{String(i + 1).padStart(2, '0')}</span>
								<h3>{w.data.title}</h3>
								<span class="attr">{w.data.attribution}</span>
							</div>
							<div class="wp-media">
								{
									w.data.video ? (
										<video controls preload="none" playsinline poster={w.data.cover} src={w.data.video} />
									) : (
										<img src={w.data.cover} alt={w.data.cover_alt} />
									)
								}
							</div>
							<div class="wp-meta">
								<span>{w.data.tools.join(' · ')}</span>
								<span class="wp-date">
									{w.data.date.getFullYear()}·{String(w.data.date.getMonth() + 1).padStart(2, '0')}
								</span>
							</div>
							<p class="wp-summary">{w.data.summary}</p>
							{w.data.links.length > 0 && (
								<div class="wp-links">
									{w.data.links.map((l) => (
										<a href={l.url} target="_blank" rel="noopener">
											{l.label} ↗
										</a>
									))}
								</div>
							)}
							{
								w.data.videos.length > 0 && (
									<div class="wp-videos">
										{w.data.videos.map((v) => (
											<figure class="wp-video-item">
												<video controls preload="none" playsinline poster={v.poster} src={v.src} />
												{v.caption && <figcaption>{v.caption}</figcaption>}
											</figure>
										))}
									</div>
								)
							}
							{w.data.gallery.length > 0 && (
								<div class="wp-gallery">
									{w.data.gallery.map((g) => <img src={g} alt="" loading="lazy" />)}
								</div>
							)}
							{w.data.process.length > 0 && (
								<section class="wp-process">
									<h4>制作过程</h4>
									{w.data.process.map((p) => (
										<figure class="wp-process-item">
											<img src={p.img} alt={p.caption} loading="lazy" />
											<figcaption>{p.caption}</figcaption>
										</figure>
									))}
								</section>
							)}
						</article>
					))
				}
			</div>
		</div>
	</div>
</BaseLayout>

<script>
	/* 底部作品条：开合 + 深链同步（?w=作品id）+ 三重退出（✕/黑罩/ESC）+ 滚动隔离 */
	const layer = document.getElementById('work-sheet');
	if (layer) {
		const body = layer.querySelector('.sheet-body')!;
		let pushed = false; // 本次打开是否压入了历史记录

		const panelOf = (id: string) => body.querySelector(`[data-panel="${CSS.escape(id)}"]`);

		function uiOpen(id: string) {
			for (const p of body.querySelectorAll('.work-panel')) p.hidden = p.dataset.panel !== id;
			layer!.classList.add('open');
			/* 滚动隔离：本站滚动容器是根元素 html（global 设了 overflow-x:clip），
			   锁 body 拦不住视口滚动——必须锁 html；body 一并锁上双保险 */
			document.documentElement.style.overflow = 'hidden';
			document.body.style.overflow = 'hidden';
		}

		function open(id: string, push = true) {
			if (!panelOf(id)) return;
			uiOpen(id);
			if (push) {
				history.pushState({ w: id }, '', `?w=${encodeURIComponent(id)}`);
				pushed = true;
			}
		}

		function uiClose() {
			layer!.classList.remove('open');
			document.documentElement.style.overflow = '';
			document.body.style.overflow = '';
		}

		function close() {
			if (!layer!.classList.contains('open')) return;
			if (pushed) {
				pushed = false;
				history.back(); // popstate 里做 uiClose
			} else {
				history.replaceState(null, '', location.pathname); // 深链直达后关闭：抹掉参数
				uiClose();
			}
		}

		document.querySelectorAll('[data-open-work]').forEach((btn) =>
			btn.addEventListener('click', () => open((btn as HTMLElement).dataset.openWork!)),
		);
		layer.querySelectorAll('[data-sheet-close]').forEach((el) => el.addEventListener('click', close));
		window.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') close();
		});
		window.addEventListener('popstate', () => {
			pushed = false;
			uiClose();
		});

		/* 深链直达：/works/3d/?w=scarab-sphere 直接滑出对应作品条 */
		const w = new URLSearchParams(location.search).get('w');
		if (w) open(w, false);
	}

	/* Vibecoding 实机 iframe：点击激活 + 加载失败兜底 */
	const liveFrame = document.querySelector('.live-frame');
	if (liveFrame) {
		const activate = liveFrame.querySelector('.activate');
		const fail = liveFrame.querySelector('.load-fail');
		const iframe = liveFrame.querySelector('iframe');
		activate?.addEventListener('click', () => liveFrame.classList.add('active'));
		let loaded = false;
		iframe?.addEventListener('load', () => (loaded = true));
		window.setTimeout(() => {
			if (!loaded) fail?.removeAttribute('hidden');
		}, 8000);
		iframe?.addEventListener('load', () => fail?.setAttribute('hidden', ''));
	}
</script>

<style>
	.page {
		padding-block: 1rem 0;
	}

	/* 内容层：全幅出血（左右到屏幕边），内容子项保持 .wrapper 对齐——
	   3D 页滚动时上移覆盖 fixed 渲染层；底边线即滚动分界 */
	.page-body {
		position: relative;
		z-index: 1;
		width: 100vw;
		margin-inline: calc(50% - 50vw);
		padding-bottom: 6rem;
	}

	.page-body > * {
		max-width: 83rem;
		margin-inline: auto;
		padding-inline: 1.5rem;
	}

	/* 分界色块（仅 3D 页）：略亮一档的底色让"内容滑上覆盖模型"的分界可辨 */
	.page-body.cover {
		background: var(--dark);
	}

	/* ---------- Vibecoding：实机嵌入（约 1.2 倍，状态卡保持同排） ---------- */
	.showcase {
		display: grid;
		grid-template-columns: minmax(0, 3fr) minmax(0, 1fr);
		gap: 22px;
		margin-bottom: 64px;
		align-items: start;
	}

	.side {
		display: grid;
		gap: 16px;
	}

	.live-frame {
		border: 1px solid var(--line);
		border-radius: var(--radius-panel);
		overflow: hidden;
		background: var(--dark-2);
	}

	.chrome {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 10px 14px;
		border-bottom: 1px solid var(--line);
	}

	.dots {
		display: flex;
		gap: 5px;
	}

	.dots i {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		border: 1px solid var(--dark-line-2);
	}

	.url {
		flex: 1;
		font-family: var(--mono);
		font-size: 11px;
		letter-spacing: 0.08em;
		color: var(--ink-2);
	}

	.open {
		font-family: var(--mono);
		font-size: 11px;
		letter-spacing: 0.06em;
		color: var(--accent);
		text-decoration: none;
	}

	.open:hover {
		text-decoration: underline;
	}

	.frame-box {
		position: relative;
	}

	/* 点击激活：iframe 默认不收指针（防滚动劫持），点覆盖层后开放交互 */
	.frame-box iframe {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 10;
		border: 0;
		background: var(--dark-2);
		pointer-events: none;
	}

	.live-frame.active .frame-box iframe {
		pointer-events: auto;
	}

	.activate {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		border: 0;
		background: transparent;
		cursor: pointer;
	}

	.activate-pill {
		font-family: var(--mono);
		font-size: 12px;
		letter-spacing: 0.14em;
		color: var(--dark-ink);
		background: rgba(23, 25, 27, 0.78);
		border: 1px solid var(--dark-line-2);
		border-radius: 999px;
		padding: 10px 22px;
		backdrop-filter: blur(3px);
		transition:
			opacity 0.25s,
			transform 0.25s;
	}

	.activate:hover .activate-pill {
		transform: translateY(-2px);
		border-color: var(--accent);
		color: var(--accent);
	}

	.live-frame.active .activate {
		display: none;
	}

	.load-fail {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		font-size: 13.5px;
		color: var(--ink-2);
		background: var(--dark-2);
	}

	.load-fail a {
		color: var(--accent);
		text-decoration: none;
		border-bottom: 1px solid var(--line);
	}

	.status-card {
		border: 1px solid var(--line);
		border-radius: var(--radius-panel);
		padding: 22px;
	}

	.status-card.muted {
		opacity: 0.85;
	}

	.status {
		display: flex;
		align-items: center;
		gap: 9px;
		font-family: var(--mono);
		font-size: 11px;
		letter-spacing: 0.16em;
		color: var(--accent);
	}

	.pulse {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent);
		animation: blink 1.6s ease-in-out infinite;
	}

	.pulse.dev {
		background: var(--dark-ink-3);
		animation: none;
	}

	@keyframes blink {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.25;
		}
	}

	.desc {
		margin-top: 12px;
		font-size: 13.5px;
		line-height: 1.8;
		color: var(--ink-2);
	}

	.links {
		display: flex;
		gap: 18px;
		margin-top: 16px;
	}

	.links a {
		font-family: var(--mono);
		font-size: 12px;
		color: var(--ink);
		text-decoration: none;
		border-bottom: 1px solid var(--line);
		padding-bottom: 2px;
	}

	.links a:hover {
		color: var(--accent);
		border-color: var(--accent);
	}

	/* ---------- 平面：破格排版 ---------- */
	.graph-hero {
		position: relative;
		margin-bottom: 64px;
		padding: 30px 0 10px;
		overflow: hidden;
	}

	.ghost {
		display: block;
		font-family: var(--serif);
		font-style: italic;
		font-size: clamp(110px, 18vw, 250px);
		line-height: 0.9;
		letter-spacing: 0.02em;
		color: var(--ink);
		opacity: 0.08;
		user-select: none;
		margin-left: -0.04em;
	}

	/* ---------- 作品网格 ---------- */
	.works h2,
	.more-cats h2 {
		display: flex;
		align-items: baseline;
		gap: 12px;
		font-size: 20px;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--ink);
		border-top: 1px solid var(--line);
		padding-top: 26px;
		margin-bottom: 30px;
	}

	.count,
	.count-alt {
		font-family: var(--mono);
		font-size: 11px;
		letter-spacing: 0.12em;
		color: var(--ink-2);
	}

	.empty {
		color: var(--ink-2);
	}

	.cards {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 44px 26px;
	}

	.cards.single {
		grid-template-columns: 1fr;
		max-width: 640px;
	}

	/* ---------- 互推卡（首页分类卡同语言） ---------- */
	.more-cats {
		margin-top: 70px;
	}

	.more-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 18px;
		max-width: 900px;
	}

	.more-card {
		display: block;
		text-decoration: none;
		perspective: 1200px; /* 悬停一角后压（与首页分类卡同语言） */
	}

	.catbox {
		position: relative;
		aspect-ratio: 3 / 4;
		overflow: hidden;
		border-radius: var(--radius-card);
		background: var(--dark);
		transform-origin: 72% 26%;
		transition: transform 0.24s cubic-bezier(0.2, 0.7, 0.3, 1);
	}

	.more-card:hover .catbox {
		transform: translateY(-5px) rotateX(6deg) rotateY(-8deg);
	}

	.catbox img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.88;
		transition: transform 0.5s ease;
	}

	.more-card:hover .catbox img {
		transform: scale(1.05);
	}

	.catbox .veil {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(20, 20, 18, 0.72) 0%, transparent 46%);
	}

	.catbox .label {
		position: absolute;
		left: 18px;
		bottom: 16px;
		color: #fff;
		z-index: 3;
	}

	.catbox .label b {
		font-size: 20px;
		letter-spacing: 0.06em;
		display: block;
		font-weight: 600;
	}

	.catbox .label span {
		font-family: var(--mono);
		font-size: 11px;
		opacity: 0.75;
		letter-spacing: 0.14em;
	}

	.catbox .no {
		position: absolute;
		top: 14px;
		right: 16px;
		font-family: var(--serif);
		font-style: italic;
		color: #fff;
		opacity: 0.85;
		font-size: 15px;
		z-index: 3;
	}

	/* ---------- 底部作品条 ---------- */
	.sheet-layer {
		position: fixed;
		inset: 0;
		z-index: 80;
		visibility: hidden;
		overscroll-behavior: contain; /* 双保险：层内滚轮不串链到文档 */
		transition: visibility 0s linear 0.5s;
