---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout fixedTheme="light" title="关于 | 陈继祖作品集" description="关于陈继祖：UE5地编 / 3D美术 与 AI 辅助开发。">
	<main class="wrapper stack gap-10 page">
		<header class="stack gap-3">
			<p class="kicker">01 — PROFILE</p>
			<h1>关于我</h1>
		</header>

		<section class="stack gap-2">
			<h2>定位</h2>
			<p class="ph-note">
				占位：定位陈述按示意稿「关于我」屏与简历内容迁移（平面设计科班 → 自学 3D 全流程 → AI
				辅助开发）。
			</p>
		</section>

		<section class="stack gap-2">
			<h2>技能矩阵</h2>
			<p class="ph-note">占位：技能矩阵可视化，内容来自 00-个人画像 技能矩阵（诚实标注熟练度）。</p>
		</section>

		<section class="stack gap-2">
			<h2>奖项</h2>
			<p class="award">2025 年湖北省职业院校技能大赛 · 数字艺术设计赛项 —— 二等奖 ｜ 优秀毕业生</p>
		</section>
	</main>
</BaseLayout>

<style>
	.page {
		padding-block: 3rem 5rem;
	}

	.kicker {
		font-family: var(--mono);
		font-size: 12px;
		letter-spacing: 0.2em;
		color: var(--ink-2);
	}

	h1 {
		color: var(--ink);
		font-size: clamp(28px, 3.6vw, 44px);
		letter-spacing: 0.03em;
	}

	section h2 {
		font-size: 20px;
		color: var(--ink);
		border-bottom: 1px solid var(--line);
		padding-bottom: 10px;
	}

	.ph-note {
		color: var(--ink-2);
		line-height: 1.8;
	}

	/* 奖项栏：左 3px 绿线（同示意稿 award-line） */
	.award {
		border: 1px solid var(--line);
		border-left: 3px solid var(--accent);
		padding: 14px 20px;
		font-size: 14.5px;
		color: var(--ink);
	}
</style>
