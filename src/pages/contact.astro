---
import BaseLayout from '../layouts/BaseLayout.astro';

const contacts = [
	{ label: '邮箱', value: 'chenjizulenning@163.com', href: 'mailto:chenjizulenning@163.com' },
	{ label: '电话', value: '187 7262 5248', href: 'tel:18772625248' },
	{ label: 'GitHub', value: 'lenmou2929', href: 'https://github.com/lenmou2929' },
	{ label: '公益站', value: 'bitsugar.top', href: 'https://bitsugar.top' },
	{ label: '视频', value: 'Bilibili / 小红书', href: undefined },
];
---

<BaseLayout title="联系 | 陈继祖作品集" description="联系陈继祖：邮箱、电话、GitHub 与简历下载。">
	<main class="wrapper stack gap-10 page">
		<header class="stack gap-3">
			<p class="kicker">04 — CONTACT</p>
			<h1>联系我</h1>
		</header>

		<ul class="facts">
			{
				contacts.map((c) => (
					<li>
						<span>{c.label}</span>
						{c.href ? <a href={c.href}>{c.value}</a> : <b>{c.value}</b>}
					</li>
				))
			}
			<li>
				<span>简历</span>
				<a href="#" aria-disabled="true">简历 PDF（中文）· Resume PDF (EN) —— 简历排版会话产出后挂载</a>
			</li>
		</ul>
	</main>
</BaseLayout>

<style>
	.page {
		padding-block: 3rem 5rem;
	}

	.kicker {
		font-family: var(--mono);
		font-size: 12px;
		letter-spacing: 0.2em;
		color: var(--ink-2);
	}

	h1 {
		color: var(--ink);
		font-size: clamp(28px, 3.6vw, 44px);
		letter-spacing: 0.03em;
	}

	/* 线性 UI：虚线分隔行（同示意稿 fact 条） */
	.facts {
		list-style: none;
		margin: 0;
		padding: 0;
		max-width: 560px;
	}

	.facts li {
		display: flex;
		justify-content: space-between;
		gap: 20px;
		padding: 14px 0;
		border-bottom: 1px dashed var(--line);
		font-size: 14.5px;
	}

	.facts span {
		color: var(--ink-2);
	}

	.facts a,
	.facts b {
		color: var(--ink);
		font-weight: 600;
		text-align: right;
		text-decoration: none;
	}

	.facts a:hover {
		color: var(--accent);
	}
</style>
