	}
	.brand b {
		font-size: 17px;
		letter-spacing: 0.06em;
		font-weight: 700;
		color: var(--ink);
	}
	.brand span {
		font-family: var(--mono);
		font-size: 11px;
		color: var(--ink-2);
		letter-spacing: 0.08em;
	}
	.nav-center {
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		gap: 44px;
	}
	.nav-center a {
		font-size: 14px;
		letter-spacing: 0.04em;
		color: var(--ink);
		transition: color 0.2s;
	}
	.nav-center a:hover {
		color: var(--accent);
	}
	.nav-right {
		margin-left: auto;
		display: flex;
		align-items: center;
		gap: 16px;
	}
	.nav-right .lang {
		font-family: var(--mono);
		font-size: 12px;
		color: var(--ink-2);
		text-decoration: none;
	}
	.nav-right .resume {
		font-size: 17px;
		font-weight: 700;
		letter-spacing: 0.06em;
		color: var(--ink);
		transition: color 0.2s;
	}
	.nav-right .resume:hover {
		color: var(--accent);
	}

	/* ---------- S1–S3 首屏 ---------- */
	#stage1 {
		height: 100vh;
		position: relative;
		overflow: hidden;
	}
	.hero-cluster {
		position: absolute;
		left: 0;
		right: 0;
		top: 50%;
		transform: translateY(-50%);
		text-align: center;
	}
	.hero-cluster .kicker {
		font-family: var(--mono);
		font-size: 13px;
		letter-spacing: 0.35em;
		color: var(--ink-2);
		display: block;
		margin-bottom: 18px;
	}
	.hero-cluster h1 {
		font-size: clamp(80px, 14.5vw, 216px);
		line-height: 0.98;
		letter-spacing: 0.04em;
		font-weight: 600;
		color: var(--ink);
	}
	.hero-cluster .en {
		font-family: var(--serif);
		font-style: italic;
		font-weight: 400;
		font-size: clamp(18px, 2.2vw, 30px);
		letter-spacing: 0.42em;
		color: var(--ink-2);
		display: block;
		margin-top: 22px;
	}
	.blocks {
		position: absolute;
		left: 7vw;
		right: 7vw;
		bottom: 11vh;
		display: grid;
		grid-template-columns: minmax(280px, 430px) minmax(280px, 430px);
		grid-template-rows: 1fr 1fr;
		grid-auto-flow: column;
		justify-content: space-between;
		row-gap: 26px;
