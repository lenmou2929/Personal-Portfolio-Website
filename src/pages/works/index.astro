---
import { getCollection } from 'astro:content';
import WorkCard from '../../components/WorkCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { WORK_CATEGORIES } from '../../lib/categories';

const entries = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) =>
	b.data.date.valueOf() > a.data.date.valueOf() ? 1 : -1,
);
---

<BaseLayout
	title="作品 | 陈继祖作品集"
	description="陈继祖的作品分类：地编/3D、Vibecoding、平面设计。"
>
	<main class="wrapper stack gap-10 page">
		<header class="stack gap-3">
			<p class="kicker">02 — WORKS</p>
			<h1>作品</h1>
			<nav class="cats">
				{WORK_CATEGORIES.map((c) => <a class="cat-link" href={`/works/${c.key}/`}>{c.label}</a>)}
			</nav>
		</header>

		<ul class="cards">
			{entries.map((w) => <WorkCard entry={w} />)}
		</ul>
	</main>
</BaseLayout>

<style>
	.page {
		padding-block: 3rem 5rem;
	}

	.kicker {
		font-family: var(--mono);
		font-size: 12px;
		letter-spacing: 0.2em;
		color: var(--ink-2);
	}

	h1 {
		color: var(--ink);
		font-size: clamp(28px, 3.6vw, 44px);
		letter-spacing: 0.03em;
	}

	.cats {
		display: flex;
		gap: 18px;
		flex-wrap: wrap;
	}

	.cat-link {
		font-size: 14px;
		color: var(--ink-2);
		text-decoration: none;
		border: 1px solid var(--line);
		border-radius: 999px;
		padding: 7px 16px;
		transition:
			color 0.2s,
			border-color 0.2s;
	}

	.cat-link:hover {
		color: var(--accent);
		border-color: var(--accent);
	}

	.cards {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 26px;
	}

	@media (max-width: 900px) {
		.cards {
			grid-template-columns: 1fr;
		}
	}
</style>
