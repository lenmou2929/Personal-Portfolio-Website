---
/** 3D 分类页首屏（2026-09-06 用户定稿 v2）：
 * 渲染层 position:fixed 铺满全屏（四边全出血，无框）——滚动时模型与渲染窗不动，
 * 标题文字与本类作品色块作为内容层上移覆盖；听筒动画随滚动 1:1 播放/暂停/倒放
 * （一屏行程）；鼠标位置微转（±13°/±6°，触屏关闭），不自动旋转、不拖转。
 * 灯光三点布光：主光（左侧）/ 辅光（右侧低亮）/ 轮廓光（后上方硬光勾边）。 */
interface Props {
	src: string;
	poster: string;
	no: string;
	en: string;
	title: string;
	lead: string;
}
const { src, poster, no, en, title, lead } = Astro.props;
---

<div class="hero3d" id="hero3d" data-src={src} aria-hidden="true">
	<img class="poster" src={poster} alt="" loading="eager" />
	<canvas class="gl"></canvas>
	<p class="note" aria-live="polite"><span class="dot"></span>LOADING — 3D MODEL</p>
</div>

<!-- 文字层：正常文档流，随滚动上移（用户要求：模型/渲染框不动，文字与内容一起走） -->
<div class="hero-space" id="hero3d-space">
	<div class="hero-text">
		<p class="kicker"><span class="no">{no} — </span>{en}</p>
		<h1>{title}</h1>
		<p class="lead">{lead}</p>
	</div>
	<p class="hint">SCROLL — 滚动拿起听筒 · 移动鼠标环视</p>
</div>

<style>
	/* 渲染层：fixed 铺满视口（四边全出血），页面内容（.page-body）从下方滚上来覆盖 */
	.hero3d {
		position: fixed;
		inset: 0;
		z-index: 0;
		background: var(--dark-2); /* 比页面底 #17191b 微亮一档，内容滑上时分界可辨 */
		pointer-events: none;
	}

	.poster {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 30%;
		opacity: 0.9;
		transition: opacity 0.8s ease;
	}

	.gl {
		position: absolute;
		top: 0;
		left: -15vw;
		width: 130vw;
		height: 100%;
		opacity: 0;
		transition: opacity 0.8s ease;
	}

	.hero3d.ready .gl {
		opacity: 1;
	}

	.hero3d.ready .poster {
		opacity: 0;
	}

	.note {
		position: absolute;
		left: 24px;
		top: 96px;
		font-family: var(--mono);
		font-size: 10.5px;
		letter-spacing: 0.18em;
		color: var(--dark-ink-2);
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.note .dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--accent);
		animation: blink 1.2s ease-in-out infinite;
	}

	@keyframes blink {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.25;
		}
	}

	.hero3d.ready .note {
		display: none;
	}

	/* 文字层：第一屏高度、透明底（透出渲染层），随滚动正常上移 */
	.hero-space {
		position: relative;
		z-index: 1;
		height: 100vh;
		margin-top: calc(-88px - 1rem); /* 抵消 BaseLayout 让位 + 页面顶距：第一屏正好一屏 */
		display: flex;
		align-items: flex-end;
		pointer-events: none;
	}

	.hero-text {
		padding: 0 clamp(20px, 4vw, 48px) clamp(26px, 6vh, 60px) clamp(20px, 4vw, 48px);
	}

	.hero-text .kicker {
		font-family: var(--mono);
		font-size: 13px;
		letter-spacing: 0.3em;
		color: var(--dark-ink-2);
		margin-bottom: 14px;
	}

	.hero-text .no {
		color: var(--accent);
	}

	.hero-text h1 {
		font-size: clamp(44px, 6vw, 76px);
		font-weight: 600;
		letter-spacing: 0.03em;
		line-height: 1.02;
		color: var(--dark-ink);
	}

	.hero-text .lead {
		margin-top: 14px;
		max-width: 520px;
		font-size: 14.5px;
		line-height: 1.8;
		color: var(--dark-ink-3);
	}

	.hint {
		position: absolute;
		right: clamp(20px, 4vw, 48px);
		bottom: clamp(26px, 6vh, 60px);
		font-family: var(--mono);
		font-size: 10.5px;
		letter-spacing: 0.16em;
		color: var(--dark-ink-2);
		text-align: right;
		transition: opacity 0.3s ease;
	}

	@media (max-width: 900px) {
		.hero-space {
			height: 100vh;
			margin-top: calc(-96px - 1rem);
		}

		.hint {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.note .dot {
			animation: none;
		}

		.gl,
		.poster {
			transition: none;
		}
	}
</style>

<script>
	import * as THREE from 'three';
	import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
	import { DRACOLoader } from 'three/addons/loaders/DRACOLoader.js';
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	const hero = document.getElementById('hero3d') as HTMLDivElement | null;

	if (hero) {
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const finePointer = window.matchMedia('(pointer: fine)').matches;
		const canvas = hero.querySelector('canvas')!;
		const note = hero.querySelector('.note')!;
		const space = document.getElementById('hero3d-space')!;

		try {
			const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
			renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
			renderer.outputColorSpace = THREE.SRGBColorSpace;

			const scene = new THREE.Scene();
			/* 相机：拉高俯视（用户要求），整机入画并留视差余量 */
			const camera = new THREE.PerspectiveCamera(30, 16 / 9, 0.1, 100);
			camera.position.set(0, 1.6, 8.4);
			camera.lookAt(0, 0, 0);

			/* ===== 三点布光（用户定稿）===== */
			scene.add(new THREE.HemisphereLight(0xf5f3ee, 0x2a2e30, 0.5)); // 环境底光压低
			const keyLight = new THREE.DirectionalLight(0xffffff, 2.2); // 主光：画面左侧
			keyLight.position.set(-5, 2.5, 4);
			scene.add(keyLight);
			const fillLight = new THREE.DirectionalLight(0xdfe8e2, 0.55); // 辅光：右侧低亮度
			fillLight.position.set(5, 1.2, 2.5);
			scene.add(fillLight);
			const rimLight = new THREE.SpotLight(0xf0f4ee, 2.6, 40, 0.55, 0.05); // 轮廓光：后上方硬光（源收窄勾边）
			rimLight.position.set(0.5, 5.5, -5.5);
			rimLight.target.position.set(0, 0, 0);
			scene.add(rimLight);
			scene.add(rimLight.target);

			/* draco 解码器走本站静态目录（public/draco/），不依赖外部 CDN */
			const draco = new DRACOLoader().setDecoderPath('/draco/');
			const loader = new GLTFLoader().setDRACOLoader(draco);

			let mixer: THREE.AnimationMixer | null = null;
			let clipDur = 0;
			let scrubProgress = 0;
			let covered = false; // 内容层盖住渲染层后暂停渲染（省 GPU）
			const tilt = { x: 0, y: 0, tx: 0, ty: 0 };
			const BASE_Y = 0.16; // 默认微微右侧朝向

			/* 鼠标视差：指针在哪，电话微微转向哪（触屏设备关闭） */
			if (finePointer && !reduced) {
				window.addEventListener('mousemove', (e) => {
					tilt.ty = (e.clientX / window.innerWidth - 0.5) * 2 * 0.22;
					tilt.tx = (e.clientY / window.innerHeight - 0.5) * 2 * 0.1;
				});
			}

			if (!reduced) {
				gsap.registerPlugin(ScrollTrigger);
				/* 滚动 1:1 驱动动画：行程一屏（innerHeight），停=停、回=倒 */
				ScrollTrigger.create({
					trigger: space,
					start: 'top top',
					end: () => '+=' + window.innerHeight,
					onUpdate: (self) => {
						scrubProgress = self.progress;
						const hint = document.querySelector('.hero3d + * .hint, #hero3d-space .hint') as HTMLElement | null;
						if (hint) hint.style.opacity = String(Math.max(0, 1 - self.progress * 8));
					},
				});
			}

			/* 内容层盖住渲染层后暂停渲染 */
			const worksEl = document.querySelector('.works');
			if (worksEl) {
				ScrollTrigger.create({
					trigger: worksEl,
					start: 'top top',
					onToggle: (self) => (covered = self.isActive),
				});
			}

			const fit = () => {
				const w = canvas.clientWidth || 1;
				const h = canvas.clientHeight || 1;
				renderer.setSize(w, h, false);
				camera.aspect = w / h;
				camera.updateProjectionMatrix();
			};
			new ResizeObserver(fit).observe(canvas);
			fit();

			loader.load(
				hero.dataset.src!,
				(gltf) => {
					const model = gltf.scene;
					/* 归一化：居中 + 等比缩放；整体左移（用户要求） */
					model.updateMatrixWorld(true);
					const box = new THREE.Box3().setFromObject(model);
					const size = box.getSize(new THREE.Vector3());
					const s = 3.4 / (Math.max(size.x, size.y, size.z) || 1);
					model.scale.setScalar(s);
					model.updateMatrixWorld(true);
					const box2 = new THREE.Box3().setFromObject(model);
					model.position.sub(box2.getCenter(new THREE.Vector3()));

					const group = new THREE.Group();
					group.add(model);
					group.position.x = -0.6; // 用户要求：整体往画面左移
					group.rotation.y = BASE_Y; // 默认微微右侧朝向
					scene.add(group);

					/* 听筒动画：不 advance（不调 mixer.update(delta)），只由滚动 setTime 采样 */
					if (gltf.animations.length > 0) {
						mixer = new THREE.AnimationMixer(model);
						const action = mixer.clipAction(gltf.animations[0]);
						action.setLoop(THREE.LoopOnce, 1);
						action.clampWhenFinished = true;
						action.play();
						clipDur = gltf.animations[0].duration || 0;
					}

					hero.classList.add('ready');

					const loop = () => {
						if (covered) return; // 被内容盖住：跳过渲染
						/* 鼠标视差阻尼跟随（叠加在默认朝向上） */
						tilt.y += (tilt.ty - tilt.y) * 0.06;
						tilt.x += (tilt.tx - tilt.x) * 0.06;
						group.rotation.y = BASE_Y + tilt.y;
						group.rotation.x = tilt.x;
						/* 滚动 → 动画时间轴（1:1；不调 mixer.update，动作不自行前进） */
						if (mixer && clipDur > 0) mixer.setTime(scrubProgress * clipDur);
						renderer.render(scene, camera);
					};
					renderer.setAnimationLoop(loop);
					document.addEventListener('visibilitychange', () => {
						renderer.setAnimationLoop(document.hidden ? null : loop);
					});
				},
				undefined,
				() => {
					note.innerHTML =
						'<span class="dot" style="animation:none;background:#a9aca5"></span>MODEL OFFLINE — 请看下方渲染图';
				},
			);
		} catch {
			note.innerHTML =
				'<span class="dot" style="animation:none;background:#a9aca5"></span>WEBGL UNAVAILABLE — 请看下方渲染图';
		}
	}
</script>
