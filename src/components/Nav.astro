---
import { WORK_CATEGORIES } from '../lib/categories';
import { CAT_EN } from '../lib/i18n-en';

/** 顶栏导航（内页，2026-09-06 用户拍板五项直连）：三个分类直进 + 关于/联系；
 * 首页顶栏为锚点版（index.astro 内联，样式同源、条目按语境）。
 * 2026-09-08：EN 内页上线——按路径自动切 EN 标签，中/EN 按钮互跳对应语言版本。 */
const isEn = Astro.url.pathname.startsWith('/en');
const links: { label: string; href: string }[] = [
	...WORK_CATEGORIES.map((c) => ({
		label: isEn ? CAT_EN[c.key] : c.label,
		href: `${isEn ? '/en' : ''}/works/${c.key}/`,
	})),
	{ label: isEn ? 'About' : '关于', href: `${isEn ? '/en' : ''}/about/` },
	{ label: isEn ? 'Contact' : '联系', href: `${isEn ? '/en' : ''}/contact/` },
];
/* 中英互跳：EN 页回中文版（去前缀），中文页去 EN 版（加前缀）；首页根路径兜底 */
const langHref = isEn
	? Astro.url.pathname.replace(/^\/en/, '') || '/'
	: '/en' + (Astro.url.pathname === '/' ? '/' : Astro.url.pathname);

const isCurrentPage = (href: string) => {
	let pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
	if (pathname.at(0) !== '/') pathname = '/' + pathname;
	if (pathname.at(-1) !== '/') pathname += '/';
	return pathname === href || (href !== '/' && pathname.startsWith(href));
};
---

<header class="topbar">
	<div class="brand">
		<a href="/"><b>陈继祖</b><span>CHEN JIZU — 3D / WEB</span></a>
	</div>
	<nav class="nav-center" aria-label={isEn ? "Main navigation" : "主导航"}>
		{
			links.map(({ label, href }) => (
				<a href={href} aria-current={isCurrentPage(href) ? 'page' : null}>
					{label}
				</a>
			))
		}
	</nav>
	<div class="nav-right">
		<a class="lang" href={langHref} aria-label={isEn ? '切换到中文' : 'Switch to English'}>中 / EN</a>
		<a class="resume" href={`${isEn ? '/en' : ''}/contact/`}>{isEn ? 'Resume' : '简历下载'}</a>
	</div>
</header>

<style>
	/* 顶栏（内页）：与首页同款——纯文字无边框 fixed，样式与 index.astro .topbar 同源同值；
	   当前页用强调色标记。2026-09-06 IA 重构：五项直连（去「作品」中间层） */
	.topbar {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 50;
		display: flex;
		align-items: center;
		padding: 20px 40px;
		background: var(--bg);
	}
	.brand {
		display: flex;
		align-items: baseline;
		gap: 12px;
	}
	.brand a {
		display: flex;
		align-items: baseline;
		gap: 12px;
		text-decoration: none;
	}
	.brand b {
		font-size: 17px;
		letter-spacing: 0.06em;
		font-weight: 700;
		color: var(--ink);
	}
	.brand span {
		font-family: var(--mono);
		font-size: 11px;
		color: var(--ink-2);
		letter-spacing: 0.08em;
	}
	.nav-center {
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		gap: 36px;
	}
	.nav-center a {
		font-size: 14px;
		letter-spacing: 0.04em;
		color: var(--ink);
		text-decoration: none;
		transition: color 0.2s;
	}
	.nav-center a:hover {
		color: var(--accent);
	}
	.nav-center a[aria-current='page'] {
		color: var(--accent);
	}
	.nav-right {
		margin-left: auto;
		display: flex;
		align-items: center;
		gap: 16px;
	}
	.nav-right .lang {
		font-family: var(--mono);
		font-size: 12px;
		color: var(--ink-2);
	}
	.nav-right .resume {
		font-size: 17px;
		font-weight: 700;
		letter-spacing: 0.06em;
		color: var(--ink);
		text-decoration: none;
		transition: color 0.2s;
	}
	.nav-right .resume:hover {
		color: var(--accent);
	}

	/* 移动端：两行——第一行品牌+简历下载，第二行五个链接 */
	@media (max-width: 900px) {
		.topbar {
			padding: 12px 20px 10px;
			flex-wrap: wrap;
		}
		.brand span {
			display: none;
		}
		.nav-right {
			margin-left: auto;
		}
		.nav-right .resume {
			font-size: 15px;
		}
		.nav-center {
			position: static;
			transform: none;
			width: 100%;
			gap: 22px;
			margin-top: 8px;
		}
		.nav-center a {
			font-size: 13px;
		}
	}
</style>
