---
import { getCollection } from 'astro:content';
import PageHead from '../../components/PageHead.astro';
import WorkCard from '../../components/WorkCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { WORK_CATEGORIES } from '../../lib/categories';

const all = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) =>
	b.data.date.valueOf() > a.data.date.valueOf() ? 1 : -1,
);
/* 占位条目垫底：真实作品按日期在前（占位仅保留结构完整性，Phase 5 移除） */
const entries = [
	...all.filter((e) => !e.data.title.startsWith('占位')),
	...all.filter((e) => e.data.title.startsWith('占位')),
];

const counts = Object.fromEntries(
	WORK_CATEGORIES.map((c) => [c.key, entries.filter((e) => e.data.category === c.key).length]),
);
---

<BaseLayout
	title="作品 | 陈继祖作品集"
	description="陈继祖的作品分类：地编/3D、Vibecoding、平面设计。"
	fixedTheme="light"
>
	<main class="wrapper page">
		<PageHead en="WORKS — INDEX" title="作品" lead="按分类索引全部作品。每个条目如实标注创作性质与完成度——教程跟做、参考还原、独立原创，看标签即可。" />

		<nav class="cats" aria-label="作品分类">
			{
				WORK_CATEGORIES.map((c) => (
					<a class="cat-link" href={`/works/${c.key}/`}>
						{c.label}
						<span class="count">{String(counts[c.key] ?? 0).padStart(2, '0')}</span>
					</a>
				))
			}
		</nav>

		<ul class="cards">
			{entries.map((w, i) => <WorkCard entry={w} index={i} />)}
		</ul>
	</main>
</BaseLayout>

<style>
	.page {
		padding-block: 1rem 6rem;
	}

	/* 分类胶囊：线性 UI（1px 描边 + mono 计数），与首页/诚实标注同语言 */
	.cats {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
		margin-bottom: 44px;
	}

	.cat-link {
		display: inline-flex;
		align-items: baseline;
		gap: 8px;
		font-size: 14px;
		color: var(--ink);
		text-decoration: none;
		border: 1px solid var(--line);
		border-radius: 999px;
		padding: 8px 18px;
		transition:
			color 0.2s,
			border-color 0.2s;
	}

	.cat-link:hover {
		color: var(--accent);
		border-color: var(--accent);
	}

	.count {
		font-family: var(--mono);
		font-size: 10.5px;
		letter-spacing: 0.1em;
		color: var(--ink-2);
	}

	.cards {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 44px 26px;
	}

	@media (max-width: 900px) {
		.cards {
			grid-template-columns: 1fr;
		}
	}
</style>
