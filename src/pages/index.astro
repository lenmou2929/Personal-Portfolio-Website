<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	/* 不设 html{scroll-behavior:smooth}——与 ScrollTrigger pin 冲突（官方已知问题）。
	   正式站动效为 scroll 事件驱动：ScrollTrigger 原生监听 scroll 事件，无兜底轮询。 */
	if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		gsap.registerPlugin(ScrollTrigger);

		/* S1–S3 首屏：四块滑入 + 大字让位 + 停留；pin 结束后整页随自然滚动划走（不做内部 transform 出画） */
		const tl = gsap.timeline({
			scrollTrigger: { trigger: '#stage1', start: 'top top', end: '+=170%', pin: true, scrub: 0.5 },
		});
		tl.to('.scroll-hint', { opacity: 0, duration: 0.5 }, 0)
			.from('.blk.col-l', { x: -70, opacity: 0, duration: 0.42, stagger: 0.07, ease: 'power2.out' }, 0.02)
			.from('.blk.col-r', { x: 70, opacity: 0, duration: 0.42, stagger: 0.07, ease: 'power2.out' }, 0.1)
			.to('.hero-cluster', { y: '-20vh', duration: 0.5, ease: 'none' }, 0)
			.to({}, { duration: 0.12 });

		/* 首屏划走期间：四块相对首屏下滑 8vh（滞后出画，画面持续有内容） */
		gsap.to('.blocks', {
			y: '8vh',
			ease: 'none',
			scrollTrigger: { trigger: '#scene-about', start: 'top bottom', end: 'top top', scrub: 0.5 },
		});

		/* S4 关于我：pin 只负责停留（入场已前移至下方「进场窗口」，v2 机制见 README 决策表 2026-09-04）。
		   停留时长 = pin 长度 '+=35%' ≈ 1/3 屏，可调 */
		gsap
			.timeline({
				scrollTrigger: { trigger: '#scene-about', start: 'top top', end: '+=35%', pin: true, scrub: 0.5 },
			})
			.to({}, { duration: 0.12 });

		/* S6 分类：pin 只负责停留（入场前移，同上） */
		gsap
			.timeline({
				scrollTrigger: { trigger: '#scene-cats', start: 'top top', end: '+=35%', pin: true, scrub: 0.5 },
			})
			.to({}, { duration: 0.12 });

		/* S7 精选：pin 内保留标题入场——暖白字必须等深色底扫上来才可读；底块与卡组的入场已前移 */
		gsap
			.timeline({
				scrollTrigger: { trigger: '#scene-rail', start: 'top top', end: '+=35%', pin: true, scrub: 0.5 },
			})
			.from('#scene-rail .sec-head', { autoAlpha: 0, duration: 0.14 }, 0)
			.from(
				'#scene-rail .sec-head h2, #scene-rail .sec-head .idx',
				{ x: -90, duration: 0.3, stagger: 0.05, ease: 'power2.out' },
				0,
			)
			.to({}, { duration: 0.12 });

		/* 三场景内容视差（退场滞后下滑，16/16/13vh 定稿值不变）。
		   ⚠️ 创建顺序纪律：退场视差必须先于下方「进场窗口」的高度锁创建——同一元素的
		   多个 scrub 补间操作同一 y 属性时，渲染与 refresh 全量重渲都按创建顺序，
		   后创建者胜出；倒置会在窗口内互相覆盖 */
		gsap.to('#scene-about .scene-inner', {
			y: '16vh',
			ease: 'none',
			scrollTrigger: { trigger: '#scene-cats', start: 'top bottom', end: 'top top', scrub: 0.5 },
		});
		gsap.to('#scene-cats .scene-inner', {
			y: '16vh',
			ease: 'none',
			scrollTrigger: { trigger: '#scene-rail', start: 'top bottom', end: 'top top', scrub: 0.5 },
		});
		gsap.to('#scene-rail .scene-inner', {
			y: '13vh',
			ease: 'none',
			scrollTrigger: { trigger: 'footer', start: 'top bottom', end: 'top top', scrub: 0.5 },
		});

		/* ============ 进场窗口（v2 核心机制） ============
		   上一场退场期间，本场内容锁定在「完全到位后应在的屏幕高度」（高度锁 y:-100vh→0
		   恰好抵消盒子上行的 900px），同时从左右滑入；页面滑到位 = 入场刚好完成。
		   触发窗口 = 本场盒子从视口底滑到顶的 900px（'top bottom' → 'top top'）。
		   精选场锁 .rail-wrap（深色底块自带背景，可在浅底上提前进场）；其标题留守 pin。
		   ⚠️ 必须在退场视差之后创建（创建顺序纪律，见上） */
		gsap
			.timeline({
				scrollTrigger: { trigger: '#scene-about', start: 'top bottom', end: 'top top', scrub: 0.5 },
			})
			.fromTo(
				'#scene-about .scene-inner',
				{ y: '-100vh' },
				{ y: '0vh', ease: 'none', duration: 1, immediateRender: false },
				0,
			)
			.from('#scene-about .sec-head', { autoAlpha: 0, duration: 0.22 }, 0.15)
			.from(
				'#scene-about .sec-head h2, #scene-about .sec-head .idx',
				{ x: -90, duration: 0.3, stagger: 0.05, ease: 'power2.out' },
				0.15,
			)
			.from('#scene-about .lead', { x: -80, autoAlpha: 0, duration: 0.32, ease: 'power2.out' }, 0.28)
			.from(
				'#scene-about .fact',
				{ x: 90, autoAlpha: 0, duration: 0.22, stagger: 0.07, ease: 'power2.out' },
				0.38,
			)
			.from('#scene-about .award-line', { y: 70, autoAlpha: 0, duration: 0.3, ease: 'power2.out' }, 0.62);

		gsap
			.timeline({
				scrollTrigger: { trigger: '#scene-cats', start: 'top bottom', end: 'top top', scrub: 0.5 },
			})
			.fromTo(
				'#scene-cats .scene-inner',
				{ y: '-100vh' },
				{ y: '0vh', ease: 'none', duration: 1, immediateRender: false },
				0,
			)
			.from('#scene-cats .sec-head', { autoAlpha: 0, duration: 0.22 }, 0.15)
			.from(
				'#scene-cats .sec-head h2, #scene-cats .sec-head .idx',
				{ x: -90, duration: 0.3, stagger: 0.05, ease: 'power2.out' },
				0.15,
			)
			.from(
				'#scene-cats .cats',
				{
					x: () => {
						const r = document.querySelector('#scene-cats .cats')!.getBoundingClientRect();
						return -(r.left + r.width + 80);
					},
					duration: 0.55,
					ease: 'power2.out',
				},
				0.25,
			);

		gsap
			.timeline({
				scrollTrigger: { trigger: '#scene-rail', start: 'top bottom', end: 'top top', scrub: 0.5 },
			})
			.fromTo(
				'#scene-rail .rail-wrap',
				{ y: '-100vh' },
				{ y: '0vh', ease: 'none', duration: 1, immediateRender: false },
				0,
			)
			.from('#scene-rail .rail-bg', { x: '100vw', duration: 0.55, ease: 'power1.out' }, 0.1)
			.from(
				'#scene-rail .rail',
				{
					x: () => {
						const r = document.querySelector('#scene-rail .rail')!.getBoundingClientRect();
						return window.innerWidth - r.left + 80;
					},
					duration: 0.6,
					ease: 'power3.out',
				},
				0.25,
			);

		/* S8 页尾：从下渐显进场 */
		gsap.from('.foot-inner', {
			y: 150,
			autoAlpha: 0,
			duration: 0.55,
			ease: 'power2.out',
			scrollTrigger: { trigger: 'footer', start: 'top 65%', end: 'top 20%', scrub: 0.5 },
		});

		/* 导航点击：落到对应场景 pin 结束前 200px（= 入场已完成的位置） */
		document.querySelectorAll<HTMLAnchorElement>('.nav-center a').forEach((a) => {
			a.addEventListener('click', (e) => {
				e.preventDefault();
				const sel = a.getAttribute('href')!;
				const t = ScrollTrigger.getAll().find(
					(t) => t.trigger && t.trigger.id === sel.slice(1) && t.pin,
				);
				if (t && t.pin) {
					window.scrollTo(0, t.end - 200);
				} else {
					window.scrollTo(0, document.documentElement.scrollHeight);
				}
			});
		});
	}
</script>

<style>
