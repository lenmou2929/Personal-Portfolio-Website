---
import '../styles/global.css';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
	/** 页面固定主题（2026-09-06 用户拍板：全站每页固定身份，无用户切换）：
	 * 分类页 'dark'，其余 'light'。首页不经此处（独立 head）。 */
	fixedTheme?: 'light' | 'dark' | undefined;
}

const {
	title = '陈继祖 · 作品集 — UE5地编 / 3D美术 · AI 辅助开发',
	description = '陈继祖作品集：UE5地编 / 3D美术（影视向 · 产品向）与 AI 辅助开发。深圳 · 随时到岗。',
	fixedTheme = 'light',
} = Astro.props;
---

<meta charset="utf-8" />
<meta name="description" property="og:description" content={description} />
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta property="og:title" content={title} />
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url?.href} />
<meta property="og:image" content="https://portfolio.onboard.wang/favicon.png" />

<link rel="icon" type="image/png" href="/favicon.png" />

{
	fixedTheme === 'dark' ? (
		<script is:inline>
			/* 固定深色页（分类页差异化）：钉死深色，无用户切换 */
			document.documentElement.classList.add('theme-dark');
		</script>
	) : (
		<script is:inline>
			document.documentElement.classList.remove('theme-dark');
		</script>
	)
}
