		</section>

		<!-- S6 分类（v4）：同一固定层机制，整排从左滑入 -->
		<section class="scene" id="scene-cats">
			<div class="scene-inner">
				<div class="sec-head"><h2>Categories</h2><span class="idx">02 — Categories</span></div>
				<div class="cats">
					{
						cats.map((c) => (
							<a class="cat" href={`/works/${c.key}/`}>
