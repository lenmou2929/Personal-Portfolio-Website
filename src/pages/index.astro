---
import { getCollection } from 'astro:content';
import Hero from '../components/Hero.astro';
import WorkCard from '../components/WorkCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const featured = await getCollection('work', ({ data }) => !data.draft && data.level === 'S');
---

<BaseLayout
	title="陈继祖 · 作品集 — 3D 美术 / 地编 · AI 辅助开发"
	description="陈继祖作品集：3D 场景美术/地编（影视向 · 产品向）与 AI 辅助开发。深圳 · 随时到岗。"
>
	<main class="wrapper stack gap-20">
		<header class="stack gap-4 home-hero">
			<p class="kicker">PORTFOLIO · 2023 — 2026</p>
			<Hero
				title="作品集"
				tagline="3D 场景美术 / 地编 · AI 辅助开发。当前为项目骨架——首页将按定稿示意稿（方案A-v3 衬线编辑风）迁移，见第 3 步开发。"
				align="start"
			>
				<div class="roles">
					<span class="pill-line">3D 美术 / 地编</span>
					<span class="pill-line">AI 辅助开发</span>
					<span class="pill-line">深圳 · 随时到岗</span>
				</div>
			</Hero>
		</header>

		<section class="stack gap-4">
			<div class="sec-row">
				<h2>精选作品</h2>
				<a href="/works/">全部作品 →</a>
			</div>
			<ul class="cards">
				{featured.map((w) => <WorkCard entry={w} />)}
			</ul>
		</section>
	</main>
</BaseLayout>

<style>
	.home-hero {
		padding-block: 4rem 1rem;
	}

	.kicker {
		font-family: var(--mono);
		font-size: 13px;
		letter-spacing: 0.35em;
		color: var(--ink-2);
	}

	.roles {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
	}

	/* 线性 UI：1px 描边胶囊 */
	.pill-line {
		font-size: 14px;
		color: var(--ink-2);
		border: 1px solid var(--line);
		border-radius: 999px;
		padding: 6px 14px;
	}

	.sec-row {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		border-bottom: 1px solid var(--line);
		padding-bottom: 14px;
	}

	.sec-row h2 {
		font-size: clamp(24px, 3vw, 36px);
		color: var(--ink);
	}

	.sec-row a {
		color: var(--accent);
		font-size: 14px;
		text-decoration: none;
	}

	.cards {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 22px;
	}

	@media (max-width: 900px) {
		.cards {
			grid-template-columns: 1fr;
		}
	}
</style>
